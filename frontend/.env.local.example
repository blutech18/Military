NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_INSTITUTION=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LON=
NEXT_PUBLIC_GPS_POLL_SECONDS=

# Basemap tiles. Defaults to OpenStreetMap, which needs no API key.
# CARTO's dark basemap now requires a key and stamps "API KEY REQUIRED" on tiles
# without one. Set these only if you move to a keyed or self-hosted provider,
# and set DARKEN=false when the provider already serves dark tiles.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=19
NEXT_PUBLIC_MAP_TILE_DARKEN=true
NEXT_PUBLIC_BIOMETRIC_BRIDGE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Never enable demo mode in a production build.
NEXT_PUBLIC_DEMO_MODE=false
