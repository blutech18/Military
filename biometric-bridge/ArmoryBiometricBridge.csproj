<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ArmoryDB biometric bridge for DigitalPersona U.are.U readers.

    Targets .NET Framework 4.8 because the One Touch for Windows SDK 1.4 ships
    .NET Framework assemblies (CLR v2) that wrap its COM components. Windows 10/11
    already include the 4.8 runtime; the .NET SDK only needs it to compile.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ArmoryBiometricBridge</RootNamespace>
    <AssemblyName>ArmoryBiometricBridge</AssemblyName>
    <!-- The One Touch .NET wrapper only works in a 32-bit process (it throws OverflowException when run as 64-bit). -->
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <DpSdkBin>$(ProgramW6432)\DigitalPersona\One Touch SDK\.NET\Bin</DpSdkBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="DPFPShrNET"><HintPath>$(DpSdkBin)\DPFPShrNET.dll</HintPath></Reference>
    <Reference Include="DPFPDevNET"><HintPath>$(DpSdkBin)\DPFPDevNET.dll</HintPath></Reference>
    <Reference Include="DPFPEngNET"><HintPath>$(DpSdkBin)\DPFPEngNET.dll</HintPath></Reference>
    <Reference Include="DPFPVerNET"><HintPath>$(DpSdkBin)\DPFPVerNET.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="bridge.settings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('bridge.settings.json')" />
  </ItemGroup>

  <Target Name="CheckDigitalPersonaSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DpSdkBin)\DPFPDevNET.dll')"
           Text="DigitalPersona One Touch for Windows SDK not found at '$(DpSdkBin)'. Install it from the SDK's Install\x64\Setup.exe first." />
  </Target>

</Project>
